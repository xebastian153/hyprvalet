# hyprvalet realtime — speech-to-speech sidecar systemd user service (example)
#
# Install:
#   uv venv ~/.local/share/hyprvalet/realtime-venv && pip install speech-to-speech==0.2.12
#   cp configs/systemd/hyprvalet-realtime.service ~/.config/systemd/user/
#   echo "CEREBRAS_API_KEY=..." > ~/.config/hyprvalet/env && chmod 0600 ~/.config/hyprvalet/env
#   systemctl --user daemon-reload
#   systemctl --user enable --now hyprvalet-realtime
#
# Cloud-first: Cerebras google/gemma-4-31B via responses_api at https://api.cerebras.ai/v1
# No local GPU VRAM required (GTX 1050 Ti 4GB constraint) — heavy work stays in
# sidecar (Silero VAD, Parakeet TDT 0.6B, Qwen3 TTS) or cloud LLM.
# Privacy: PCM leaves machine only if CEREBRAS_API_KEY set (0600 opt-in, file
# must be chmod 0600); else fallback to Ollama http://localhost:11434/v1.

[Unit]
Description=hyprvalet realtime — speech-to-speech sidecar (Silero+SmartTurn->Parakeet->Cerebras->Qwen3)
After=network-online.target pipewire.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/share/hyprvalet/realtime-venv/bin/speech-to-speech --mode realtime --ws_host 127.0.0.1 --ws_port 8765 --device cpu --stt parakeet-tdt --parakeet_tdt_device cpu --tts facebookMMS --tts_language es --llm_backend chat-completions --model_name gemma-4-31b --responses_api_base_url https://api.cerebras.ai/v1 --responses_api_api_key ${CEREBRAS_API_KEY} --no_responses_api_disable_thinking
Restart=on-failure
RestartSec=2
EnvironmentFile=-%h/.config/hyprvalet/env
Environment=LD_LIBRARY_PATH=%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/cuda_runtime/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/cublas/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/cufft/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/curand/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/cuda_nvrtc/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/nvjitlink/lib:%h/.local/share/hyprvalet/realtime-venv/lib/python3.14/site-packages/nvidia/cu13/lib:/opt/cuda/lib64
# CEREBRAS_API_KEY is read from EnvironmentFile (chmod 0600 ~/.config/hyprvalet/env). Never inline secrets here.
# Voice: Aiden (en) / es-AR variant configurable via --voice.

[Install]
WantedBy=default.target
